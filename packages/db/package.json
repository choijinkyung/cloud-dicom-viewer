{
  "name": "@dicom-viewer/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node ../../node_modules/pnpm/bin/pnpm.cjs exec prisma generate",
    "migrate:dev": "node ../../node_modules/pnpm/bin/pnpm.cjs exec prisma migrate dev",
    "studio": "node ../../node_modules/pnpm/bin/pnpm.cjs exec prisma studio",
    "seed": "node ../../node_modules/pnpm/bin/pnpm.cjs exec tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "tsx": "^4.19.3"
  }
}
